# ============================================================
#  HealthFlow Backend — Environment Variables
#  Copy this to .env and fill in real values
#  NEVER commit .env to git
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Frontend URL (for CORS) ───────────────────────────────────
CLIENT_URL=https://your-frontend.vercel.app

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string (from Railway / Supabase / Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ── Email ─────────────────────────────────────────────────────
# Local dev:  EMAIL_PROVIDER=ethereal  (auto-creates test account)
# Production: EMAIL_PROVIDER=smtp      (fill SMTP_* below)
EMAIL_PROVIDER=ethereal
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HealthFlow Care <no-reply@healthflow.local>"

# ── Google Gemini AI ──────────────────────────────────────────
GEMINI_API_KEY=
AI_FALLBACK_MODE=false

# ── Google Calendar OAuth 2.0 ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend.railway.app/api/calendar/callback

# ── Background Workers ────────────────────────────────────────
WORKER_INTERVAL_SECONDS=15
SLOT_HOLD_DURATION_MINUTES=5
