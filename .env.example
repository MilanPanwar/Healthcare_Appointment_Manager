# ============================================================
# HEALTHCARE APPOINTMENT & FOLLOW-UP MANAGER - ENVIRONMENT CONFIG
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Prisma)
# For local SQLite: file:./dev.db
# For PostgreSQL: postgresql://user:password@localhost:5432/healthflow?schema=public
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_for_healthcare_system_change_in_production_min_32_chars!
JWT_EXPIRES_IN=7d

# LLM / AI Configuration (Gemini API or OpenAI compatible)
# Get a free key from https://aistudio.google.com/
GEMINI_API_KEY=
# Fallback mock mode enabled if GEMINI_API_KEY is empty: true/false
AI_FALLBACK_MODE=true

# Email Service (Nodemailer)
# Options: 'smtp' or 'ethereal' (auto-generates test inbox preview links)
EMAIL_PROVIDER=ethereal
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HealthFlow Care <no-reply@healthflow.local>"

# Google Calendar OAuth 2.0
# Obtain credentials from Google Cloud Console (Calendar API enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://healthcare-appointment-manager-6f7c.onrender.com/api/calendar/callback

# Background Workers
WORKER_INTERVAL_SECONDS=15
SLOT_HOLD_DURATION_MINUTES=5
